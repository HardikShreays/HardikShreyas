# Public site origin. Drives canonical URL, sitemap.xml and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Sanity CMS. Until these are set the site renders the checked-in data in /data,
# and /studio will not load.
# Get them from https://sanity.io/manage after creating a project.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
